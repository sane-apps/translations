 "boundary_moves": [
  {
   "from": "4",
   "to": "5",
   "moved_chars": 57,
   "moved_start": "[ἐν δὲ] ἔσονται οἱ πρῶτοι ἔσχατοι καὶ οἱ ἔσχατοι πρῶτοι.«"
  },
  {
   "from": "13",
   "to": "14",
   "moved_chars": 56,
   "moved_start": "Οὐκ ἄρα ἀπορριπτέον τὰ καὶ τοὺς πέλας ὠφελοῦντα χρήματα·"
  },
  {
   "from": "15",
   "to": "16",
   "moved_chars": 69,
   "moved_start": "κελεύων ἀποθέσθαι οὐ τὰ βιωτικά, ἀλλὰ τὰ τούτοις κακῶς χρώμε"
  },
  {
   "from": "16",
   "to": "17",
   "moved_chars": 677,
   "moved_start": "ὁ μὲν γὰρ ἔχων κτήματα καὶ χρυσὸν καὶ ἄργυρον καὶ οἰκίας ὡς "
  },
  {
   "from": "19",
   "to": "20",
   "moved_chars": 131,
   "moved_start": "ἐκεῖνα ἐχέτωσαν οἱ σάρκινοι πτωχοὶ καὶ τούτων δεόμενοι, σὺ δ"
  },
  {
   "from": "25",
   "to": "26",
   "moved_chars": 41,
   "moved_start": "»ἐν δὲ τῷ ἐρχομένῳ ζωή[ν] ἐστιν αἰώνιος.«"
  },
  {
   "from": "26",
   "to": "27",
   "moved_chars": 183,
   "moved_start": "σημαινέτω μὲν οὖν τι καὶ ὑψηλότερον ἡ κάμηλος διὰ στενῆς ὁδο"
  },
  {
   "from": "27",
   "to": "28",
   "moved_chars": 54,
   "moved_start": "Δευτέραν δὲ τάξει καὶ οὐδέν τι μικροτέραν ταύτης εἶναι"
  },
  {
   "from": "30",
   "to": "31",
   "moved_chars": 76,
   "moved_start": "καὶ ἀλλαχοῦ· »ὁ ὑμᾶς δεχόμενος ἐμὲ δέχεται, ὁ ὑμᾶς μὴ δεχόμε"
  },
  {
   "from": "31",
   "to": "32",
   "moved_chars": 115,
   "moved_start": "οὑτοσὶ δὲ ὁ λόγος ὑπὲρ ἅπασάν ἐστι θεότητα, μηδὲ αἰτεῖσθαι π"
  },
  {
   "from": "38",
   "to": "39",
   "moved_chars": 98,
   "moved_start": "μηδὲ γὰρ τοῦτο εἰς ἀπόγνωσίν σοι καὶ ἀπόνοιαν καταλελείφθω, "
  }
